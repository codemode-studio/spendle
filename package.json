{
  "name": "spendle",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "host=$(tailscale ip -4) && vite dev --host \"$host\" --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'data/**' --exclude 'packages/**' --exclude '.repos/**'",
    "test:watch": "vitest --exclude 'data/**' --exclude 'packages/**' --exclude '.repos/**'",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm --filter @spendle/server verify",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "setup:check": "tsx scripts/doctor.ts",
    "sync:effect-docs": "scripts/sync-effect-docs.sh",
    "qa:start": "tsx scripts/qa.ts start",
    "qa:inspect": "tsx scripts/qa.ts inspect",
    "qa:clean": "tsx scripts/qa.ts clean",
    "bench": "tsx scripts/benchmark.ts",
    "fixtures:pdf": "node scripts/generate-pdf-fixture.mjs",
    "test:pdf": "vitest run src/features/finance/pdf-synthetic.integration.test.ts src/features/finance/pdf-inspector.server.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@firecrawl/pdf-inspector": "1.17.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@shadcn/react": "^0.3.1",
    "@spendle/server": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.34",
    "ai": "^7.0.48",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "effect": "catalog:",
    "lucide-react": "^1.28.0",
    "ofx-data-extractor": "^1.5.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
