{
  "name": "spendle",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --host localhost --port 3000",
    "dev:api": "vp run --filter @spendle/server dev",
    "generate-routes": "tsr generate",
    "build": "vp build .",
    "preview": "vp preview --host 127.0.0.1",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --exclude 'data/**' --exclude 'packages/**' --exclude '.repos/**'",
    "test:watch": "vp test --exclude 'data/**' --exclude 'packages/**' --exclude '.repos/**'",
    "verify": "vp run typecheck && vp lint && vp fmt --check && vp run test && vp run build && vp run --filter @spendle/server verify",
    "fmt": "vp fmt && vp lint --fix",
    "fmt:check": "vp fmt --check",
    "setup:check": "tsx scripts/doctor.ts",
    "sync:effect-docs": "scripts/sync-effect-docs.sh",
    "qa:start": "tsx scripts/qa.ts start",
    "qa:inspect": "tsx scripts/qa.ts inspect",
    "qa:clean": "tsx scripts/qa.ts clean"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@spendle/server": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.34",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "effect": "catalog:",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
