{
  "name": "@spendle/server",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/api/definition/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --watch src/bin.ts",
    "start": "node --env-file-if-exists=../../.env.local src/bin.ts",
    "migrate-v1": "node --env-file-if-exists=../../.env.local src/migrate-v1.ts",
    "claim-space": "node --env-file-if-exists=../../.env.local src/claim-space.ts",
    "qa": "node src/testing/QaServer.ts",
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run",
    "verify": "vp run typecheck && vp run test",
    "eval:categories": "node --env-file-if-exists=../../.env.local src/evals/EvalCategories.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@firecrawl/pdf-inspector": "1.17.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
