# Copy to .env.local, then uncomment and fill in what you use. One file for the
# web app and the V2 server (`pnpm dev` and `pnpm dev:api` both read it).
# Leave unused variables commented: an empty value counts as set.
# Never commit .env.local.

# Web app → V2 API
# Where the V2 server listens, and the token it requires (if any).
SPENDLE_API_URL=http://127.0.0.1:4100
# SPENDLE_API_TOKEN=

# V2 server
# SQLite database (default: data/v2/spendle.sqlite).
# SPENDLE_DATABASE_PATH=
# HTTP port and interface (defaults: 4100, 127.0.0.1 = this machine only).
# Exposing it beyond loopback requires SPENDLE_API_TOKEN (32+ chars,
# e.g. `openssl rand -hex 32`).
SPENDLE_SERVER_PORT=4100
SPENDLE_SERVER_HOST=127.0.0.1

# Pluggy (Open Finance)
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_WEBHOOK_URL=
# PLUGGY_WEBHOOK_SECRET=

# TypeSafe (Jev category classifier)
# TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_APPLY_THRESHOLD=
# TYPESAFE_API_URL=https://api.typesafe.ai

# OpenRouter
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
