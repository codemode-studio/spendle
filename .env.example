# Copy to .env.local and fill in what you use; `vp run dev` and `vp run dev:api`
# both read it. Leave unused variables commented: an empty value counts as set.
# Everything else has a default; see packages/server/README.md.

# Each family space has its own SQLite database under data/v2/spaces/, with
# data/v2/control.sqlite listing spaces and members (SPENDLE_DATA_DIR moves
# them). SPENDLE_DATABASE_PATH is the database from before spaces; claim it once
# with `vp run --filter @spendle/server claim-space --email <you>`. Relative
# paths resolve from packages/server, where the server runs.
SPENDLE_DATABASE_PATH="../../data/v2/spendle.sqlite"

# OpenRouter (assistant and category classifier)
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Sign-in with Google (Better Auth). The app refuses to start a sign-in
# without these. Generate the secret with `openssl rand -base64 32`; changing it
# signs everyone out, and MCP sign-ins fail until the old signing keys are
# gone (delete the auth database's `jwks` rows). BETTER_AUTH_URL is also the
# origin MCP clients use: `<BETTER_AUTH_URL>/api/mcp`. The Google client must list
# <BETTER_AUTH_URL>/api/auth/callback/google as a redirect URI.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed in, separated by commas. Empty allows no one.
SPENDLE_ALLOWED_EMAILS=
# Better Auth's own database (people, sessions, MCP clients). Relative to the
# repository root, where the web app runs.
# SPENDLE_AUTH_DATABASE_PATH=data/auth/auth.sqlite

# Pluggy (Open Finance)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
