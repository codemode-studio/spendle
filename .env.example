# Copy to .env.local and fill in what you use; `pnpm dev` and `pnpm dev:api`
# both read it. Leave unused variables commented: an empty value counts as set.
# Everything else has a default; see packages/server/README.md.

# SQLite database (default: data/v2/spendle.sqlite at the repo root).
# Relative paths resolve from packages/server, where the server runs.
# SPENDLE_DATABASE_PATH=

# Pluggy (Open Finance)
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=

# TypeSafe (category classifier)
# TYPESAFE_API_KEY=

# OpenRouter (assistant)
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
