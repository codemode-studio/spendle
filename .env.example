# Copy to .env.local and fill in what you use; `vp run dev` and `vp run dev:api`
# both read it. Leave unused variables commented: an empty value counts as set.
# Everything else has a default; see packages/server/README.md.

# SQLite database. Relative paths resolve from packages/server, where the
# server runs; this is the default, data/v2/spendle.sqlite at the repo root.
SPENDLE_DATABASE_PATH="../../data/v2/spendle.sqlite"

# OpenRouter (assistant)
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Sign-in with Google (Better Auth). The app refuses to start a sign-in
# without these. Generate the secret with `openssl rand -base64 32`; changing it
# signs everyone out. The Google client must list
# <BETTER_AUTH_URL>/api/auth/callback/google as a redirect URI.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed in, separated by commas. Empty allows no one.
SPENDLE_ALLOWED_EMAILS=

# Pluggy (Open Finance)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# TypeSafe (category classifier)
TYPESAFE_API_KEY=
